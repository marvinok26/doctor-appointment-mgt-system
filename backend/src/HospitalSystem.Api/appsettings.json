{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=HospitalSystem;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "HospitalSystem",
    "Audience": "HospitalSystem.Client",
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_VIA_USER_SECRETS_OR_ENV_VARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenAbsoluteDays": 7,
    "RefreshTokenIdleMinutes": 30
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "FromAddress": "no-reply@hospitalsystem.local",
    "FromName": "Hospital Appointment System",
    "UseSsl": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Seed": {
    "AdminEmail": "admin@hospitalsystem.local",
    "AdminPassword": "ChangeMe!2026Secure"
  },
  "AllowedHosts": "*"
}
